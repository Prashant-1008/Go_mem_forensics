# Byte-compiled / cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Packaging / build
*.egg-info/
dist/
build/

# Forensic evidence and generated reports must never be committed.
# Directory markers and documentation stubs are explicitly allowed back in.
evidence/*
!evidence/README.md
!evidence/.gitkeep

reports/*
!reports/.gitkeep

# Built fixture binaries are build artifacts, not source - rebuild via
# scripts/fixtures/build_fixture.ps1 rather than committing them.
tests/fixtures/go/bin/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store
